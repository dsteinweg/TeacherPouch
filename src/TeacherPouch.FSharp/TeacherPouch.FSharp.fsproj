<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>8.0</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AssemblyName>TeacherPouch.FSharp.App</AssemblyName>
        <EnableDefaultContentItems>true</EnableDefaultContentItems>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="8.0.200" />
        <PackageReference Include="Giraffe" Version="6.3.0" />
        <PackageReference Include="Giraffe.ViewEngine" Version="1.4.0" />
        <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.2" />
        <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="5.4.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="SQLProvider" Version="1.3.27" />
        <PackageReference Include="System.Data.Common" Version="4.3.0" />
        <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Database.fs" />
        <Compile Include="Roles.fs" />
        <Compile Include="DiscriminatedUnionHelper.fs" />
        <Compile Include="Domain.fs" />
        <Compile Include="Services.fs" />
        <Compile Include="Urls.fs" />
        <Compile Include="Pages\Layout.fs" />
        <Compile Include="Pages\PrivacyPolicy.fs" />
        <Compile Include="Pages\Search.fs" />
        <Compile Include="Pages\Home.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <TypeScriptCompile Include="wwwroot\scripts\TeacherPouch.ts">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </TypeScriptCompile>
        <None Include="npm-postinstall.ps1" />
        <None Include="yarn.lock" />
    </ItemGroup>

</Project>
